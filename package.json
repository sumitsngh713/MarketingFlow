{
  "name": "marketingflow-root",
  "version": "1.0.0",
  "type": "module",
  "description": "MarketingFlow - Marketing Automation & Employee Management SaaS Web Application",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "prisma:push": "npm run prisma:push --prefix server",
    "prisma:generate": "npm run prisma:generate --prefix server",
    "seed": "npm run seed --prefix server",
    "build:client": "npm run build --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "test": "node server/src/tests/testAll.js"
  },
  "keywords": [
    "marketing-automation",
    "employee-management",
    "crm",
    "attendance",
    "cold-email",
    "whatsapp",
    "linkedin",
    "saas"
  ],
  "author": "MarketingFlow Team",
  "license": "MIT"
}
