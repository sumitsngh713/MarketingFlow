# ===================================================
# MarketingFlow Server Environment Configuration Reference
# ===================================================

# Server Port
PORT=5000

# Database Connection URL
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL):
# DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/marketingflow?schema=public"

# JWT Authentication Secrets
JWT_SECRET="replace_with_a_secure_random_string_min_32_chars"
JWT_EXPIRES_IN="24h"

# AES-256 Symmetric Encryption Key for Sensitive Credentials (SMTP & WhatsApp Tokens)
# Must be exactly 32 characters
ENCRYPTION_KEY="marketingflow_32bytes_encryption!"

# Public Base URL for Open Tracking Pixels & Unsubscribe Links
BASE_URL="http://localhost:5000"

# Optional: Auto-seed on server startup (true / false)
AUTO_SEED=true
